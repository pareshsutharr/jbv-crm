{
  "name": "growthavenues-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate",
    "test:e2e": "playwright test",
    "start:e2e": "NEXTAUTH_URL=http://localhost:3000 GOOGLE_CLIENT_ID=mock-google GOOGLE_CLIENT_SECRET=mock-google-secret GOOGLE_AUTH_URL=http://localhost:4455/google/auth GOOGLE_TOKEN_URL=http://localhost:4455/google/token GOOGLE_API_URL=http://localhost:4455/google/api GOOGLE_GMAIL_URL=http://localhost:4455/google/gmail MICROSOFT_CLIENT_ID=mock-ms MICROSOFT_CLIENT_SECRET=mock-ms-secret MICROSOFT_LOGIN_URL=http://localhost:4455/ms MICROSOFT_GRAPH_URL=http://localhost:4455/graph WHATSAPP_SERVICE_URL=http://localhost:4455/wa WHATSAPP_SERVICE_TOKEN=mock-wa-token next start -p 3000",
    "mock:providers": "node e2e/mocks/provider-mock.mjs",
    "db:seed:prod": "tsx prisma/seed-production.ts",
    "whatsapp": "node whatsapp/server.mjs",
    "whatsapp:pm2": "pm2 start whatsapp/ecosystem.config.cjs && pm2 save"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "next-auth": "^4.24.15",
    "nodemailer": "^7.0.13",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
