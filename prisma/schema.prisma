// Be IPO Ready CRM — Prisma schema
//
// Domain: Be IPO Ready advises companies on fund raising, pre-IPO, SME /
// mainboard IPOs and valuation. A Lead is a company enquiry; a Client is a
// company we've onboarded; a Mandate is one engagement (e.g. an SME IPO)
// moving through a stage pipeline.
//
// Design notes:
// - Client is the hub entity. New modules add their own models with a
//   `clientId` FK rather than adding columns to Client.
// - Document is generic: KYC uploads are just documents with a KYC_* category.
//   A general document vault only needs new DocumentCategory values.
// - AuditLog is a generic, append-only activity trail keyed by entityType +
//   entityId, so new entities get history without schema changes.
// - KycStatusChange is a dedicated, strongly-typed audit table for the KYC
//   workflow because compliance reporting queries it directly.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: the app's connection. On Supabase use the pooled
// ("Transaction pooler", port 6543, add ?pgbouncer=true) URI.
// DIRECT_URL: a direct / session connection used by `prisma migrate`.
// Locally both can be the same URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  COMPLIANCE
  RM
  VIEWER
}

enum LeadSource {
  WEBSITE
  READINESS_CALL // "Book an IPO Readiness Call" on the website
  READINESS_CHECK // "Are you IPO ready? 2-minute check" on the website
  REFERRAL
  EVENT
  CALL_IN
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  DISCOVERY // discovery call held
  QUALIFIED
  CONVERTED
  LOST
}

// Services offered (beipoready.com → Services).
enum ServiceLine {
  FUND_RAISING
  PRE_IPO
  SME_IPO
  MAINBOARD_IPO
  VALUATION_RESTRUCTURING
}

enum EntityType {
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  LLP
  PARTNERSHIP
  PROPRIETORSHIP
  OTHER
}

enum ListingBoard {
  NSE_EMERGE
  BSE_SME
  MAINBOARD
  NOT_APPLICABLE // private placement, valuation, etc.
}

// Union of all stages; each service uses its own ordered subset (src/lib/mandates.ts).
enum MandateStage {
  PROPOSAL
  MANDATE_SIGNED
  DUE_DILIGENCE
  RESTRUCTURING
  DRHP_DRAFTING
  DRHP_FILED
  OBSERVATIONS
  APPROVAL
  RHP_FILED
  ROADSHOW
  ISSUE_OPEN
  LISTED
  INVESTOR_OUTREACH
  TERM_SHEET
  DOCUMENTATION
  DRAFT_REPORT
  COMPLETED
  ON_HOLD
  DROPPED
}

enum KycStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum DocumentCategory {
  // Company onboarding KYC
  KYC_COI // certificate of incorporation
  KYC_PAN // company PAN
  KYC_GST
  KYC_MOA_AOA
  KYC_BOARD_RESOLUTION
  KYC_PROMOTER_KYC
  // Engagement & transaction documents
  NDA
  PROPOSAL
  ENGAGEMENT_LETTER
  FINANCIALS
  ITR
  DUE_DILIGENCE
  VALUATION_REPORT
  PITCH_DECK
  DRHP
  RHP
  OTHER
}

enum IpoStatus {
  UPCOMING
  OPEN
  CLOSED
  LISTED
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  WHATSAPP
  NOTE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  OPEN
  DONE
}

enum NotificationType {
  KYC_STATUS
  LEAD_ASSIGNED
  CLIENT_ASSIGNED
  TASK_ASSIGNED
  TASK_DUE
  MANDATE_STAGE
  MANDATE_DUE
  USER_JOINED
}

enum IntegrationProvider {
  GOOGLE
  MICROSOFT
  SMTP // any mailbox with an app password: sending only (invites carry a calendar file)
}

enum MeetingProvider {
  GOOGLE_MEET
  TEAMS
  ZOOM
  PHONE
  IN_PERSON
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

// ─── Users & auth ─────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           Role      @default(VIEWER)
  // Self-signups are created inactive and must be activated by an Admin.
  active         Boolean   @default(true)
  // Profile & personal channels (set during onboarding, editable under My account).
  designation    String? // e.g. "CEO", "Relationship Manager"
  phone          String?
  whatsapp       String? // WhatsApp number incl. country code; used for click-to-chat links
  meetingLink    String? // personal meeting room (Zoom / Meet) offered when scheduling without a calendar
  // Staff WhatsApp alerts (new website enquiries): sent from the firm's linked
  // WhatsApp, or via CallMeBot when the user registered a key with it.
  whatsappAlerts Boolean   @default(true)
  callMeBotKey   String?
  // Set when the user finishes the onboarding checklist (invited users) or is seeded/created by an admin.
  onboardedAt    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invitationsSent    Invitation[] @relation("InvitationInvitedBy")
  acceptedInvitation Invitation?  @relation("InvitationAccepted")

  assignedLeads        Lead[]                @relation("LeadAssignedRm")
  createdLeads         Lead[]                @relation("LeadCreatedBy")
  assignedClients      Client[]              @relation("ClientAssignedRm")
  uploadedDocuments    Document[]
  kycStatusChanges     KycStatusChange[]
  auditLogs            AuditLog[]
  createdIpos          Ipo[]
  mandatesLed          Mandate[]             @relation("MandateLeadAdvisor")
  mandatesCreated      Mandate[]             @relation("MandateCreatedBy")
  mandateStageChanges  MandateStageChange[]
  interactionsLogged   Interaction[]         @relation("InteractionLoggedBy")
  interactionsEdited   Interaction[]         @relation("InteractionEditedBy")
  interactionsDeleted  Interaction[]         @relation("InteractionDeletedBy")
  interactionRevisions InteractionRevision[]
  tasksAssigned        Task[]                @relation("TaskAssignee")
  tasksCreated         Task[]                @relation("TaskCreator")
  notifications        Notification[]
  connectedAccounts    ConnectedAccount[]
  meetingsOrganized    Meeting[]
  emailMessages        EmailMessage[]

  @@index([role])
}

// An admin's invitation to join the CRM. The invitee opens the emailed link,
// sets a password and is walked through onboarding (connect mailbox, add
// WhatsApp). The token is stored hashed for lookup and encrypted so an admin
// can copy / re-share the link later.
model Invitation {
  id             String    @id @default(cuid())
  email          String
  name           String?
  designation    String?
  phone          String? // optional: lets the admin WhatsApp the link directly
  role           Role      @default(RM)
  tokenHash      String    @unique
  tokenEncrypted String
  expiresAt      DateTime
  invitedById    String
  invitedBy      User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  // Delivery of the invitation email (via the system mailbox, see src/lib/system-mail.ts).
  sentAt         DateTime?
  sentVia        String? // "GOOGLE" | "MICROSOFT" | "SMTP"
  sendError      String?
  acceptedAt     DateTime?
  acceptedUserId String?   @unique
  acceptedUser   User?     @relation("InvitationAccepted", fields: [acceptedUserId], references: [id], onDelete: SetNull)
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([email])
  @@index([invitedById])
}

// ─── Leads & clients ──────────────────────────────────────────────────────

// A company enquiry. `name` is the contact person; `companyName` the business.
model Lead {
  id               String       @id @default(cuid())
  companyName      String
  name             String
  designation      String?
  phone            String
  email            String?
  city             String?
  sector           String?
  serviceInterest  ServiceLine?
  revenueCr        Decimal?     @db.Decimal(14, 2) // latest annual revenue, ₹ crore
  // Website "2-minute IPO-ready check": score 0–100 and the raw answers.
  readinessScore   Int?
  readinessAnswers Json?
  source           LeadSource   @default(OTHER)
  status           LeadStatus   @default(NEW)
  notes            String?
  assignedRmId     String?
  assignedRm       User?        @relation("LeadAssignedRm", fields: [assignedRmId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?        @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  convertedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Set once the lead is converted. The lead row is kept for history.
  client       Client?
  interactions Interaction[]
  tasks        Task[]
  contacts     Contact[]
  meetings     Meeting[]
  emails       EmailMessage[]

  @@index([status])
  @@index([assignedRmId])
  @@index([source])
  @@index([createdAt])
}

// A company we advise.
model Client {
  id                String     @id @default(cuid())
  name              String // registered company name
  cin               String?    @unique
  panNumber         String?    @unique // company PAN
  gstin             String?
  entityType        EntityType @default(PRIVATE_LIMITED)
  sector            String?
  incorporationYear Int?
  city              String?
  state             String?
  website           String?
  phone             String?
  email             String?
  source            LeadSource @default(OTHER)
  // Latest audited financials (₹ crore) — used for SME / mainboard screening.
  financialYear     String? // e.g. "FY2025-26"
  revenueCr         Decimal?   @db.Decimal(14, 2)
  ebitdaCr          Decimal?   @db.Decimal(14, 2)
  patCr             Decimal?   @db.Decimal(14, 2)
  netWorthCr        Decimal?   @db.Decimal(14, 2)
  kycStatus         KycStatus  @default(PENDING)
  notes             String?
  assignedRmId      String?
  assignedRm        User?      @relation("ClientAssignedRm", fields: [assignedRmId], references: [id], onDelete: SetNull)
  leadId            String?    @unique
  lead              Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  documents        Document[]
  kycStatusChanges KycStatusChange[]
  interactions     Interaction[]
  tasks            Task[]
  contacts         Contact[]
  mandates         Mandate[]
  meetings         Meeting[]
  emails           EmailMessage[]

  @@index([kycStatus])
  @@index([assignedRmId])
  @@index([createdAt])
}

// People at a lead or client company (promoter, CFO, company secretary…).
model Contact {
  id          String   @id @default(cuid())
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([leadId])
  @@index([email])
}

// ─── Documents & KYC ──────────────────────────────────────────────────────

model Document {
  id           String           @id @default(cuid())
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mandateId    String?
  mandate      Mandate?         @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  category     DocumentCategory
  title        String? // display name; falls back to fileName
  fileName     String // original filename as uploaded
  storageKey   String           @unique // path/key inside the storage backend
  mimeType     String
  sizeBytes    Int
  // Versioning: every upload is a new row. Versions of one logical document
  // share `groupId` (the id of version 1); only the newest has isLatest.
  // Files are never overwritten or deleted.
  groupId      String
  version      Int              @default(1)
  isLatest     Boolean          @default(true)
  notes        String?
  uploadedById String?
  uploadedBy   User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@unique([groupId, version])
  @@index([clientId, category])
  @@index([clientId, isLatest])
}

model KycStatusChange {
  id          String     @id @default(cuid())
  clientId    String
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromStatus  KycStatus?
  toStatus    KycStatus
  note        String?
  changedById String?
  changedBy   User?      @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([clientId, createdAt])
}

// ─── Generic audit trail ──────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  entityType String // "Lead", "Client", "User", ...
  entityId   String
  action     String // "created", "updated", "status_changed", "converted", ...
  // Arbitrary details, e.g. { field: { from, to } }
  metadata   Json?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// ─── IPO issues ───────────────────────────────────────────────────────────
// Issue details (price band, lot size, dates). Linked to the mandate when it
// is one of our own issues; unlinked rows serve as a market tracker.

model Ipo {
  id            String    @id @default(cuid())
  companyName   String
  symbol        String? // exchange symbol once known
  exchange      String? // e.g. "NSE, BSE"
  priceBandLow  Decimal   @db.Decimal(12, 2)
  priceBandHigh Decimal   @db.Decimal(12, 2)
  lotSize       Int
  openDate      DateTime  @db.Date
  closeDate     DateTime  @db.Date
  listingDate   DateTime? @db.Date
  status        IpoStatus @default(UPCOMING)
  notes         String?
  createdById   String?
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  mandate Mandate?

  @@index([status])
  @@index([openDate])
}

// ─── Interaction log (Phase 2) ────────────────────────────────────────────
// Permanent communication record for compliance continuity. Rows are never
// hard-deleted: Admin edits keep the prior text in InteractionRevision and
// Admin "deletes" are soft deletes with a mandatory reason.

model Interaction {
  id           String          @id @default(cuid())
  type         InteractionType
  occurredAt   DateTime
  summary      String
  leadId       String?
  lead         Lead?           @relation(fields: [leadId], references: [id], onDelete: Restrict)
  clientId     String?
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  loggedById   String
  loggedBy     User            @relation("InteractionLoggedBy", fields: [loggedById], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now())
  editedAt     DateTime?
  editedById   String?
  editedBy     User?           @relation("InteractionEditedBy", fields: [editedById], references: [id], onDelete: Restrict)
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?           @relation("InteractionDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deleteReason String?

  revisions InteractionRevision[]

  @@index([leadId, occurredAt])
  @@index([clientId, occurredAt])
}

model InteractionRevision {
  id                 String          @id @default(cuid())
  interactionId      String
  interaction        Interaction     @relation(fields: [interactionId], references: [id], onDelete: Restrict)
  previousType       InteractionType
  previousOccurredAt DateTime
  previousSummary    String
  reason             String
  editedById         String
  editedBy           User            @relation(fields: [editedById], references: [id], onDelete: Restrict)
  createdAt          DateTime        @default(now())

  @@index([interactionId, createdAt])
}

// ─── Tasks & reminders (Phase 3) ──────────────────────────────────────────

model Task {
  id           String       @id @default(cuid())
  title        String
  description  String?
  dueAt        DateTime
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(OPEN)
  completedAt  DateTime?
  // Linked to exactly one lead or client (enforced by a CHECK constraint).
  leadId       String?
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedToId String
  assignedTo   User         @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdById  String?
  createdBy    User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assignedToId, status, dueAt])
  @@index([leadId])
  @@index([clientId])
}

// ─── Notifications (Phase 3) ──────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  // For generated reminders (task due, IPO closing): one per user per key.
  dedupeKey String?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

// ─── Settings (Phase 3) ───────────────────────────────────────────────────

// Singleton row (id = 1): firm profile shown across the CRM.
model CompanyProfile {
  id                 Int      @id @default(1)
  firmName           String   @default("Be IPO Ready")
  tagline            String?
  email              String?
  phone              String?
  website            String?
  address            String?
  sebiRegistration   String?
  logoKey            String? // storage key of the uploaded logo
  logoMime           String?
  // System emails (invitations, test mails) are sent through this user's
  // connected Gmail / Outlook mailbox; falls back to the SMTP settings below
  // (or SMTP_* env), then to the first admin with a connected mailbox.
  systemSenderUserId String?
  // SMTP for system email, editable under Settings → System email. When
  // smtpHost is set these override the SMTP_* environment variables.
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPass           String? // encrypted (AES-256-GCM, see src/lib/crypto.ts)
  smtpFrom           String?
  smtpSecure         Boolean  @default(false) // implicit TLS (port 465); otherwise STARTTLS when offered
  updatedAt          DateTime @updatedAt
  updatedById        String?
}

// ─── Mandates (engagement pipeline) ───────────────────────────────────────

model Mandate {
  id             String       @id @default(cuid())
  code           String       @unique // e.g. BIR-2026-007
  title          String
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  service        ServiceLine
  board          ListingBoard @default(NOT_APPLICABLE)
  stage          MandateStage @default(PROPOSAL)
  stageChangedAt DateTime     @default(now())
  issueSizeCr    Decimal?     @db.Decimal(14, 2) // target raise / issue size, ₹ crore
  retainerFee    Decimal?     @db.Decimal(14, 2) // ₹
  successFeePct  Decimal?     @db.Decimal(5, 2) // % of amount raised
  expectedFee    Decimal?     @db.Decimal(14, 2) // ₹, retainer + success fee estimate
  targetDate     DateTime?    @db.Date // expected listing / closing
  signedAt       DateTime? // mandate signed
  closedAt       DateTime? // listed / completed / dropped
  notes          String?
  leadAdvisorId  String?
  leadAdvisor    User?        @relation("MandateLeadAdvisor", fields: [leadAdvisorId], references: [id], onDelete: SetNull)
  ipoId          String?      @unique
  ipo            Ipo?         @relation(fields: [ipoId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?        @relation("MandateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stageChanges MandateStageChange[]
  documents    Document[]
  meetings     Meeting[]

  @@index([stage])
  @@index([clientId])
  @@index([leadAdvisorId])
}

model MandateStageChange {
  id          String        @id @default(cuid())
  mandateId   String
  mandate     Mandate       @relation(fields: [mandateId], references: [id], onDelete: Cascade)
  fromStage   MandateStage?
  toStage     MandateStage
  note        String?
  changedById String?
  changedBy   User?         @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([mandateId, createdAt])
}

// ─── Integrations: Google / Microsoft accounts ────────────────────────────
// A user's connected mailbox + calendar. Tokens are encrypted at rest
// (AES-256-GCM, see src/lib/crypto.ts).

model ConnectedAccount {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     IntegrationProvider
  email        String
  accessToken  String // encrypted (for SMTP: the mailbox / app password)
  refreshToken String? // encrypted
  expiresAt    DateTime?
  scopes       String?
  // SMTP mailboxes (provider = SMTP); smtpUser only when the login differs from the address
  smtpHost     String?
  smtpUser     String?
  smtpPort     Int?
  smtpSecure   Boolean             @default(false)
  lastSyncAt   DateTime?
  syncError    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  emails EmailMessage[]

  @@unique([userId, provider])
}

// ─── Meetings ─────────────────────────────────────────────────────────────

model Meeting {
  id               String               @id @default(cuid())
  title            String
  agenda           String?
  startAt          DateTime
  endAt            DateTime
  provider         MeetingProvider
  joinUrl          String?
  location         String?
  // Calendar event created in the organiser's Google / Microsoft calendar.
  externalProvider IntegrationProvider?
  externalEventId  String?
  attendees        Json // [{ name?, email }]
  status           MeetingStatus        @default(SCHEDULED)
  outcome          String?
  leadId           String?
  lead             Lead?                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mandateId        String?
  mandate          Mandate?             @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  organizerId      String
  organizer        User                 @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([organizerId, startAt])
  @@index([clientId, startAt])
  @@index([leadId, startAt])
}

// ─── Email conversations ──────────────────────────────────────────────────
// Only messages exchanged with a known lead/client contact are stored.

model EmailMessage {
  id         String              @id @default(cuid())
  accountId  String?
  account    ConnectedAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  provider   IntegrationProvider
  externalId String
  threadId   String?
  subject    String
  snippet    String?
  bodyText   String?
  fromEmail  String
  fromName   String?
  toEmails   String[]
  ccEmails   String[]
  sentAt     DateTime
  direction  EmailDirection
  userId     String // mailbox owner
  user       User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  leadId     String?
  lead       Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId   String?
  client     Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())

  @@unique([provider, userId, externalId])
  @@index([clientId, sentAt])
  @@index([leadId, sentAt])
  @@index([threadId])
}
